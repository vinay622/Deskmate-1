---
import ShortForm from "../ui/ShortForm.astro";

const links = [
  { name: "Home", href: "/" },
  { name: "Features", href: "/#features" },
  { name: "How It Works", href: "/#how-it-works" },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/contact" },
  { name: "Open App", href: "/app/chat" },
];
---

<section class="sm:px-5">
  <div class="w-full max-w-[1240px] mx-auto">
    <div class="px-[15px] bg-dark text-gray py-[55px] lg:px-[60px] sm:rounded-t-[45px]">
      <div>
        <div class="flex flex-col lg:flex-row gap-7 items-center justify-between">
          <a href="/" class="flex items-center">
            <span class="text-2xl font-medium text-white">
              Desk<span class="text-green">Mate</span>
            </span>
          </a>
          <ul class="flex flex-col sm:flex-row gap-5">
            {links.map((link) => (
              <li class="text-center">
                <a class="underline" href={link.href}>{link.name}</a>
              </li>
            ))}
          </ul>
          <div class="flex gap-4 items-center">
            <a href="mailto:support@deskmate.app" class="text-green underline text-sm">support@deskmate.app</a>
          </div>
        </div>

        <div class="flex flex-col lg:flex-row mt-[66px] mb-[51px]">
          <div class="flex text-center lg:text-start flex-col w-full lg:w-[30%]">
            <h3 class="mb-5 text-center md:text-left text-2xl text-green">Contact us</h3>
            <div class="flex flex-col justify-between gap-4">
              <span>Email: support@deskmate.app</span>
              <span>Partnerships: partnerships@deskmate.app</span>
              <span class="lg:w-3/4">Response time: within 24 hours on working days</span>
            </div>
          </div>
          <div class="flex-grow my-10 lg:my-0 lg:ml-12">
            <ShortForm />
          </div>
        </div>
      </div>

      <div class="h-[1px] bg-gray mb-5"></div>
      <div class="flex flex-col lg:flex-row h-20 justify-center mt-4 text-center md:justify-between md:mt-0">
        <span>
          &copy; 2024 DeskMate &mdash; Built with
          <a class="underline" target="_blank" href="https://astro.build">Astro</a>
        </span>
        <span class="text-[#666] text-sm mt-2 lg:mt-0">
          AI-powered college assistant &mdash; No hallucinations, always cited.
        </span>
      </div>
    </div>
  </div>
</section>
