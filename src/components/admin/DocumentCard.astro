---
import Card from '../ui/Card.astro';

interface Props {
  id: string;
  name: string;
  category: string;
  uploadedByName: string;
  createdAt: string;
  expiryDate: string | null;
  status: 'active' | 'expiring' | 'expired';
  description: string;
  fileType?: string | null;
  processingStatus?: string;
}

const { name, category, uploadedByName, createdAt, expiryDate, status, description, fileType, processingStatus } = Astro.props;

const statusConfig = {
  active:   { label: 'Active',        cls: 'bg-green text-dark' },
  expiring: { label: 'Expiring Soon', cls: 'bg-yellow-400 text-dark' },
  expired:  { label: 'Expired',       cls: 'bg-red-500 text-white' },
};
const s = statusConfig[status] ?? statusConfig.active;

const processingConfig: Record<string, { label: string; cls: string }> = {
  pending:    { label: 'Pending',       cls: 'bg-gray-200 text-gray-600' },
  processing: { label: 'Processing...', cls: 'bg-blue-100 text-blue-600' },
  ready:      { label: 'Indexed',       cls: 'bg-emerald-100 text-emerald-700' },
  failed:     { label: 'Failed',        cls: 'bg-red-100 text-red-600' },
};
const ps = processingConfig[processingStatus ?? 'pending'] ?? processingConfig.pending;

function getFileLabel(ft: string | null | undefined): string {
  if (!ft) return '';
  if (ft === 'application/pdf') return 'PDF';
  if (ft.includes('wordprocessingml')) return 'DOCX';
  if (ft === 'text/plain') return 'TXT';
  if (ft.startsWith('image/')) return 'IMG';
  return '';
}
const fileLabel = getFileLabel(fileType);

const formattedDate = new Date(createdAt).toLocaleDateString('en-IN', {
  day: 'numeric', month: 'short', year: 'numeric',
});
const formattedExpiry = expiryDate
  ? new Date(expiryDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })
  : null;
---

<Card isUnderline={true}>
  <div class="p-6 bg-gray rounded-[45px]">
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1 flex-wrap">
          <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${s.cls}`}>{s.label}</span>
          <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${ps.cls}`}>{ps.label}</span>
          <span class="text-xs text-[#666] bg-[#e0e0e0] px-2 py-0.5 rounded-full">{category}</span>
          {fileLabel && <span class="text-xs text-[#888] bg-[#eee] px-2 py-0.5 rounded-full font-mono">{fileLabel}</span>}
        </div>
        <h3 class="font-medium text-dark text-base truncate">{name}</h3>
        {description && <p class="text-sm text-[#777] mt-1 line-clamp-2">{description}</p>}
      </div>
      <button
        data-action="delete-doc"
        class="text-xs bg-red-100 text-red-600 px-3 py-1.5 rounded-lg border border-red-200 hover:bg-red-200 transition-colors shrink-0"
      >
        Delete
      </button>
    </div>
    <div class="h-[1px] bg-[#ddd] my-3"></div>
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-[#777]">
      <span>Added by {uploadedByName || 'Admin'} on {formattedDate}</span>
      {formattedExpiry && <span>Expires {formattedExpiry}</span>}
    </div>
  </div>
</Card>
