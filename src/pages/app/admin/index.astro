---
import MainLayout from "../../../layouts/MainLayout.astro";
import Section from "../../../components/sections/Section.astro";
import Card from "../../../components/ui/Card.astro";
import { createSupabaseServerClient } from "../../../lib/supabase";

// Server-side auth check
const { request, cookies, locals } = Astro;

if (!locals.user || locals.userRole !== 'admin') {
  return Astro.redirect('/login');
}

const supabase = createSupabaseServerClient(request, cookies);

const [
  { count: docCount },
  { count: staffCount },
  { data: recentDocs },
] = await Promise.all([
  supabase.from('documents').select('*', { count: 'exact', head: true }).eq('college_name', locals.collegeName),
  supabase.from('staff_members').select('*', { count: 'exact', head: true }).eq('college_name', locals.collegeName),
  supabase
    .from('documents')
    .select('id, name, category, created_at, status')
    .eq('college_name', locals.collegeName)
    .order('created_at', { ascending: false })
    .limit(5),
]);

const stats = [
  { label: "Total Documents", value: docCount ?? 0 },
  { label: "Active Staff",    value: staffCount ?? 0 },
];
---

<MainLayout title="Admin Dashboard — DeskMate" description="Manage DeskMate documents and staff directory.">
  <Section id="admin">
    <div class="mt-20 mb-20">

      <!-- Header -->
      <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
        <div>
          <p class="text-sm text-[#666] mb-1">
            <a href="/" class="underline">Home</a> / Admin
          </p>
          <h1 class="text-4xl font-medium">
            <span class="greenhead">Admin</span> Dashboard
          </h1>
        </div>
        <a href="/app/chat" class="btn-secondary px-5 py-3 rounded-2xl">Open Chat</a>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 gap-5 mb-10 max-w-sm">
        {stats.map((stat) => (
          <Card isUnderline={true}>
            <div class="p-6 bg-gray rounded-[45px]">
              <p class="text-[#666] text-sm">{stat.label}</p>
              <span class="text-4xl font-medium mt-1 block">{stat.value}</span>
            </div>
          </Card>
        ))}
      </div>

      <!-- Quick Actions -->
      <div class="flex gap-4 mb-10 flex-wrap">
        <a href="/app/admin/documents" class="btn-primary px-8 py-4 rounded-2xl">Manage Documents</a>
        <a href="/app/admin/staff" class="btn-secondary px-8 py-4 rounded-2xl">Manage Staff</a>
      </div>

      <!-- Recent Documents -->
      <div class="mb-10">
        <h2 class="text-2xl font-medium mb-4">Recent Documents</h2>
        <div class="bg-gray rounded-[45px] overflow-hidden border border-dark shadow-[0px_5px_0px_#191a23]">
          {(recentDocs && recentDocs.length > 0) ? (
            <table class="w-full">
              <thead>
                <tr class="border-b border-[#ddd]">
                  <th class="text-left p-4 pl-8 font-medium text-dark">Document</th>
                  <th class="text-left p-4 font-medium text-dark hidden md:table-cell">Category</th>
                  <th class="text-left p-4 font-medium text-dark hidden lg:table-cell">Added</th>
                  <th class="text-left p-4 font-medium text-dark">Status</th>
                </tr>
              </thead>
              <tbody>
                {recentDocs.map((doc) => (
                  <tr class="border-b border-[#eee] last:border-0 hover:bg-[#e8e8e8] transition-colors">
                    <td class="p-4 pl-8 text-sm font-medium">{doc.name}</td>
                    <td class="p-4 text-sm text-[#666] hidden md:table-cell">{doc.category}</td>
                    <td class="p-4 text-sm text-[#666] hidden lg:table-cell">
                      {new Date(doc.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                    </td>
                    <td class="p-4">
                      <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${
                        doc.status === 'active'   ? 'bg-green text-dark' :
                        doc.status === 'expiring' ? 'bg-yellow-400 text-dark' :
                        'bg-red-100 text-red-600'
                      }`}>
                        {doc.status === 'active' ? 'Active' : doc.status === 'expiring' ? 'Expiring' : 'Expired'}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <div class="p-12 text-center text-[#aaa] text-sm">No documents uploaded yet.</div>
          )}
        </div>
        {(recentDocs && recentDocs.length > 0) && (
          <div class="mt-3 text-right">
            <a href="/app/admin/documents" class="text-sm underline text-[#666]">View all &rarr;</a>
          </div>
        )}
      </div>

    </div>
  </Section>
</MainLayout>
